# =====================================================================
# STATXI Environment Variables Configuration
# =====================================================================

# 1. Supabase / PostgreSQL Credentials
# When set, STATXI synchronizes and reads from your real Supabase instance.
# If omitted or during local dev, STATXI seamlessly utilizes the built-in storage engine.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 2. Football Data Providers
# Supported values: 'api' (live API-Football) or 'mock' (built-in authentic top-tier dataset)
DATA_PROVIDER=mock
API_FOOTBALL_KEY=your_api_football_v3_key

# 3. Market Value Providers
# Supported values: 'highlightly', 'mock'
MARKET_VALUE_PROVIDER=mock
MARKET_VALUE_API_KEY=your_market_value_api_key

# 4. App & Admin Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_SECRET_KEY=statxi_admin_secret_key_2026
